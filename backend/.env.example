# Copy this file to .env and replace all production secrets before deployment.

# --- App ---
# Allowed values: development, production, test.
APP_ENV=development
# When starting uvicorn manually, pass the same host/port on its command line
# if you change these values.
APP_HOST=0.0.0.0
APP_PORT=8000
# Exact Host header values accepted by the API. Never use * in production.
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
# Only these direct reverse-proxy peers may supply X-Forwarded-For.
TRUSTED_PROXY_IPS=127.0.0.1,::1
# Global request envelope; individual upload limits remain stricter.
MAX_REQUEST_BODY_BYTES=10485760

# --- Database ---
# Async driver used by the application at runtime. URL-encode special
# characters in the username or password.
DATABASE_URL=mysql+aiomysql://candles:candles@localhost:3306/candles
# Sync driver used by Alembic. Keep both URLs pointed at the same database.
DATABASE_URL_SYNC=mysql+pymysql://candles:candles@localhost:3306/candles

# --- JWT and authentication ---
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
# Optional. Required only if you decide to use TOTP MFA endpoints.
# Generate independently: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=
# Keep false if admins should be able to use the admin panel without MFA.
ADMIN_MFA_REQUIRED=false
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MIN=60
# Keep `lax` when the frontend and API are same-site. Use `none` only for a
# cross-site production setup over HTTPS.
AUTH_COOKIE_SAMESITE=lax
# Optional parent domain for sibling subdomains. Empty means host-only cookies.
AUTH_COOKIE_DOMAIN=

# --- CORS ---
# Comma-separated exact frontend origins, without paths or trailing slashes.
# Credentialed requests cannot use `*`. Add every dev/prod frontend origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080

# --- Local file storage ---
# Relative paths are resolved from the backend working directory.
LOCAL_STORAGE_ROOT=./storage
# Usually these directory names should not change after files are uploaded.
STORAGE_CATEGORY_PRODUCTS=product-images
STORAGE_CATEGORY_COMPANY=company-assets
STORAGE_CATEGORY_RECEIPTS=payment-receipts
# Absolute public URL prefix for product images and company assets.
PUBLIC_UPLOAD_URL_BASE=http://localhost:8000/uploads
# Public backend origin used to create signed private-receipt URLs.
BACKEND_BASE_URL=http://localhost:8000
# Signed receipt URL lifetime, in seconds.
RECEIPT_URL_TTL_SEC=300
# Maximum size of one uploaded image or receipt: 5 MiB, in bytes.
UPLOAD_MAX_BYTES=5242880

# --- Inventory webhook ---
# Generate with: openssl rand -hex 16
INVENTORY_WEBHOOK_SECRET=replace-me

# --- API rate limiting ---
# Keep enabled outside automated tests.
RATE_LIMIT_ENABLED=true
# Production must use shared Redis storage for multiple workers/instances.
RATE_LIMIT_STORAGE_URI=memory://

# --- SMTP (optional) ---
# Leave SMTP_HOST empty to disable outgoing email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=CANDWAX
SMTP_USE_TLS=true

# --- Bootstrap admin ---
# Used only by: python -m scripts.bootstrap_admin
BOOTSTRAP_ADMIN_EMAIL=admin@candles.local
# Empty in development generates and prints a random password. Set a strong
# value before running the bootstrap script in production.
BOOTSTRAP_ADMIN_PASSWORD=

# --- Public frontend URL ---
# Used in outgoing email links, such as password reset.
WEB_APP_URL=http://localhost:8080
