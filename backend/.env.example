# --- App ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Database ---
# Async driver (used by the app at runtime)
DATABASE_URL=postgresql+asyncpg://candles:candles@postgres:5432/candles
# Sync driver (used by Alembic migrations)
DATABASE_URL_SYNC=postgresql+psycopg://candles:candles@postgres:5432/candles

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MIN=60

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Storage (MinIO / S3-compatible) ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET_PRODUCTS=product-images
S3_BUCKET_COMPANY=company-assets
# Public URL prefix used when returning image URLs to the client
S3_PUBLIC_URL_BASE=http://localhost:9000

# --- Inventory webhook ---
INVENTORY_WEBHOOK_SECRET=replace-me

# --- SMTP (for sending emails to customers) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Candle Wholesale
SMTP_USE_TLS=true

# --- Bootstrap admin (used by a one-off script) ---
BOOTSTRAP_ADMIN_EMAIL=admin@candles.local
BOOTSTRAP_ADMIN_PASSWORD=

# --- Public web app URL (used to build links in outgoing emails, e.g. password reset) ---
WEB_APP_URL=http://localhost:8080
