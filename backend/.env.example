# --- App ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Database ---
# Async driver (used by the app at runtime)
DATABASE_URL=mysql+aiomysql://candles:candles@localhost:3306/candles
# Sync driver (used by Alembic migrations)
DATABASE_URL_SYNC=mysql+pymysql://candles:candles@localhost:3306/candles

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MIN=60

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Storage (local filesystem) ---
# Root dir where uploaded files are saved (relative to the backend cwd or absolute).
LOCAL_STORAGE_ROOT=./storage
# Absolute base URL the backend serves PUBLIC uploads from (product images,
# company assets). Must be absolute — the frontend uses these URLs directly.
PUBLIC_UPLOAD_URL_BASE=http://localhost:8000/uploads
# Backend's own public origin — used to build signed URLs for private receipts.
BACKEND_BASE_URL=http://localhost:8000
# How long a signed payment-receipt URL stays valid (seconds).
RECEIPT_URL_TTL_SEC=300

# --- Inventory webhook ---
INVENTORY_WEBHOOK_SECRET=replace-me

# --- SMTP (for sending emails to customers) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=CANDWAX
SMTP_USE_TLS=true

# --- Bootstrap admin (used by a one-off script) ---
BOOTSTRAP_ADMIN_EMAIL=admin@candles.local
BOOTSTRAP_ADMIN_PASSWORD=

# --- Public web app URL (used to build links in outgoing emails, e.g. password reset) ---
WEB_APP_URL=http://localhost:8080
